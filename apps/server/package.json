{
  "name": "@siteflow/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch --clear-screen=false --import @siteflow/observability/server/register src/index.ts",
    "dev:worker": "tsx watch --clear-screen=false --import @siteflow/observability/server/register src/worker.ts",
    "dev:all": "concurrently --names API,WORKER --prefix-colors blue,green \"pnpm dev\" \"pnpm dev:worker\"",
    "start": "node --import @siteflow/observability/server/register dist/index.js",
    "start:worker": "node --import @siteflow/observability/server/register dist/worker.js",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@fastify/cookie": "^10.0.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.0",
    "@fastify/sensible": "^6.0.2",
    "@fastify/swagger": "^9.4.0",
    "@fastify/swagger-ui": "^5.2.1",
    "@opentelemetry/api": "^1.9.0",
    "@siteflow/database": "workspace:*",
    "@siteflow/env": "workspace:*",
    "@siteflow/observability": "workspace:*",
    "@siteflow/shared": "workspace:*",
    "bcryptjs": "^2.4.3",
    "drizzle-orm": "^0.36.4",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.0.1",
    "google-auth-library": "^11.1.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.0.10",
    "pg": "^8.13.1",
    "pg-boss": "^10.1.2",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@siteflow/eslint-config": "workspace:*",
    "@siteflow/typescript-config": "workspace:*",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.1",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.10",
    "@vitest/coverage-v8": "^3.0.0",
    "concurrently": "^10.0.5",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^3.0.0"
  }
}
