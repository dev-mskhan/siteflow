# ─── SiteFlow Monorepo Environment Variables (.env.example) ──────────────────
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database (PostgreSQL - docker-compose app-infra service on port 5433)
PLATFORM_BOOTSTRAP_EMAIL=
DATABASE_URL=postgres://siteflow:siteflow@localhost:5433/siteflow

# Connection pool
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=20000

# Redis
REDIS_URL=redis://localhost:6379
# Auth attempts per IP per 15 min (raise to ~1000 for local E2E runs)
AUTH_RATE_LIMIT_MAX=10

# MinIO / S3 Object Storage
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_DOCUMENTS=siteflow-documents
MINIO_USE_SSL=false
STORAGE_PRESIGN_EXPIRY_SECONDS=3600
REPORT_EXPORT_RETENTION_HOURS=24
REPORT_EXPORT_SIGNED_URL_EXPIRY_SECONDS=300
EXPIRY_SCAN_DAYS_AHEAD=30

# OpenTelemetry Collector (SigNoz / OTLP)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=siteflow-server
# Set to 'true' to send test run spans to SigNoz (useful for debugging flaky tests)
OTEL_ENABLE_IN_TEST=false

# Auth / JWT / Cookies
JWT_SECRET=siteflow-super-secret-jwt-key-at-least-32-chars-long!
JWT_EXPIRY=15m
COOKIE_SECRET=siteflow-super-secret-cookie-key-at-least-32-chars!
REFRESH_TOKEN_EXPIRY_DAYS=30

# SMTP / Email Configuration
# If left unset in dev, EmailService automatically creates a free Ethereal Email test account and logs preview URLs.
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASS=re_123456789
SMTP_FROM=SiteFlow <noreply@siteflow.dev>

# Google OAuth 2.0
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback
# FRONTEND_URL=http://localhost:5173

# CORS (comma-separated list of allowed origins)
CORS_ORIGIN=http://localhost:5173

# Logging
LOG_LEVEL=debug

# Request / body limits
REQUEST_TIMEOUT_MS=25000
BODY_LIMIT_BYTES=1048576

# ─── AI / LLM ─────────────────────────────────────────────────────────────────
# Provider: 'fake' (no key needed for local dev), 'openai', or 'google'
AI_PROVIDER=fake
# OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=...

# ─── AI Observability — Langfuse ──────────────────────────────────────────────
# Local dev: headless-seeded by docker-compose — just start the container, no UI setup.
LANGFUSE_HOST=http://localhost:3020
LANGFUSE_PUBLIC_KEY=pk-lf-siteflow-dev
LANGFUSE_SECRET_KEY=sk-lf-siteflow-dev
#
# Production (Langfuse Cloud — 50k observations/month free):
#   Remove LANGFUSE_HOST and replace keys:
# LANGFUSE_PUBLIC_KEY=pk-lf-<your-cloud-key>
# LANGFUSE_SECRET_KEY=sk-lf-<your-cloud-key>

# ─── Voice / STT — Whisper ────────────────────────────────────────────────────
# Local dev: Speaches container (faster-whisper, CPU, no API key, port 3900)
VOICESTUDIO_URL=http://localhost:3900
# VOICESTUDIO_API_KEY=       # leave blank — local whisper needs no key
# VOICE_MODEL=whisper-1      # default; change to 'whisper-large-v3-turbo' for Groq
#
# Production (Groq Cloud — 8 h/day free, 200× real-time):
# VOICESTUDIO_URL=https://api.groq.com/openai
# VOICESTUDIO_API_KEY=gsk_<your-groq-key>
# VOICE_MODEL=whisper-large-v3-turbo
