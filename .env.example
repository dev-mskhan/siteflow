# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database (matches docker-compose postgres service)
DATABASE_URL=postgres://siteflow:siteflow@localhost:5433/siteflow

# Redis
REDIS_URL=redis://localhost:6379

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_DOCUMENTS=siteflow-documents
MINIO_USE_SSL=false

# OpenTelemetry (start observability profile first)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=siteflow-server

# Logging
LOG_LEVEL=debug

# ─── Web ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_OTEL_ENDPOINT=http://localhost:4318
